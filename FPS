-- 메인 ESP / 레이더 / 환경 업데이트 루프
local lastFpsTime = os.clock()
local frameCount = 0
local currentFps = 60

RunService.RenderStepped:Connect(function()
	local cam = workspace.CurrentCamera
	if not cam then return end

	frameCount += 1
	local now = os.clock()
	if now - lastFpsTime >= 0.5 then
		currentFps = math.floor(frameCount / (now - lastFpsTime))
		frameCount = 0
		lastFpsTime = now
	end

	local espColor = getEspColor()
	darkShade.Visible = state.darkOverlay
	crosshair.Visible = state.crosshairDot
	fovCircle.Visible = state.aimbot and state.showFov
	fovCircle.Size = UDim2.new(0, state.fovRadius * 2, 0, state.fovRadius * 2)
	radarFrame.Visible = state.radarEnabled
	cam.FieldOfView = state.camFovBoost and 100 or 70

	if state.noFog then
		Lighting.FogEnd = 1e6
	end
	if state.fullBright then
		Lighting.ClockTime = 14
		Lighting.Brightness = 2.5
	end

	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

	if state.airFloat and myRoot then
		floatPart.Position = myRoot.Position - Vector3.new(0, 3.8, 0)
	else
		floatPart.Position = Vector3.new(0, -500, 0)
	end

	hudLabel.Visible = state.fpsHud or state.posHud
	if hudLabel.Visible then
		local lines = {}
		if state.fpsHud then table.insert(lines, "FPS: " .. tostring(currentFps)) end
		if state.posHud and myRoot then
			table.insert(lines, string.format("POS: %.0f, %.0f, %.0f", myRoot.Position.X, myRoot.Position.Y, myRoot.Position.Z))
		end
		hudLabel.Text = table.concat(lines, "\n")
	end

	local vpSize = cam.ViewportSize
	local tracerOrigin = Vector2.new(vpSize.X * 0.5, vpSize.Y)

	for _, plr in ipairs(Players:GetPlayers()) do
		local v = getVisual(plr)
		local blip = getRadarBlip(plr)
		local enemy = isEnemyForEsp(plr)
		local char = plr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local head = char and char:FindFirstChild("Head")

		-- 레이더 블립 갱신
		if state.radarEnabled and enemy and hrp and myRoot and hum and hum.Health > 0 then
			local rel = hrp.Position - myRoot.Position
			local scale = (radarFrame.AbsoluteSize.X * 0.45) / math.max(state.radarRange, 20)
			local rx = math.clamp(rel.X * scale, -radarFrame.AbsoluteSize.X * 0.44, radarFrame.AbsoluteSize.X * 0.44)
			local rz = math.clamp(rel.Z * scale, -radarFrame.AbsoluteSize.Y * 0.44, radarFrame.AbsoluteSize.Y * 0.44)
			blip.Position = UDim2.new(0.5, rx, 0.5, rz)
			blip.BackgroundColor3 = espColor
			blip.Visible = true
		else
			blip.Visible = false
		end

		if enemy and char and hum and hum.Health > 0 and hrp and head then
			v.boxStroke.Color = espColor
			v.headStroke.Color = espColor
			v.hl.FillColor = espColor
			v.hl.OutlineColor = Color3.fromRGB(255, 255, 255)
			v.hl.Adornee = char
			v.hl.Enabled = state.esp3D

			local topWorld, topOn = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.85, 0))
			local botWorld, botOn = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.0, 0))
			local centerWorld, centerOn = cam:WorldToViewportPoint(hrp.Position)

			local rawHeight = math.abs(topWorld.Y - botWorld.Y)
			local boxHeight = math.clamp(rawHeight, 12, 440)
			local boxWidth = math.clamp(boxHeight * 0.54, 10, 240)

			if state.esp2D and (topOn or botOn or centerOn) and centerWorld.Z > 0 then
				local cx = (topWorld.X + botWorld.X) * 0.5
				local topY = math.min(topWorld.Y, botWorld.Y)
				v.box.Size = UDim2.new(0, boxWidth, 0, boxHeight)
				v.box.Position = UDim2.new(0, cx - boxWidth * 0.5, 0, topY)
				v.box.Visible = true

				v.hpBg.Visible = state.healthBar
				if state.healthBar then
					local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
					v.hpFill.Size = UDim2.new(1, 0, ratio, 0)
				end

				local namePart = state.showName and plr.DisplayName or ""
				local distPart = (state.showDistance and myRoot) and (" [" .. math.floor((hrp.Position - myRoot.Position).Magnitude) .. "m]") or ""
				v.tag.Text = namePart .. distPart
				v.tag.Visible = (namePart ~= "" or distPart ~= "")
			else
				v.box.Visible = false
			end

			if state.tracers and centerOn and centerWorld.Z > 0 then
				updateLine(v.tracer, tracerOrigin, Vector2.new(centerWorld.X, centerWorld.Y), 1.3, espColor)
			else
				v.tracer.Visible = false
			end

			if state.skeleton then
				local headVP, headOn = cam:WorldToViewportPoint(head.Position)
				if headOn and headVP.Z > 0 then
					local radiusPx = math.clamp(rawHeight * 0.065, 2, 10)
					v.headCircle.Size = UDim2.new(0, radiusPx * 2, 0, radiusPx * 2)
					v.headCircle.Position = UDim2.new(0, headVP.X, 0, headVP.Y)
					v.headCircle.Visible = true
				else
					v.headCircle.Visible = false
				end

				local isR15 = char:FindFirstChild("UpperTorso") ~= nil
				local pairsList = isR15 and BONE_PAIRS_R15 or BONE_PAIRS_R6
				local boneIdx = 1
				for _, pair in ipairs(pairsList) do
					if boneIdx <= #v.bones then
						local pA = char:FindFirstChild(pair[1])
						local pB = char:FindFirstChild(pair[2])
						if pA and pA:IsA("BasePart") and pB and pB:IsA("BasePart") then
							local sA, onA = cam:WorldToViewportPoint(pA.Position)
							local sB, onB = cam:WorldToViewportPoint(pB.Position)
							if (onA or onB) and sA.Z > 0 and sB.Z > 0 then
								updateLine(v.bones[boneIdx], Vector2.new(sA.X, sA.Y), Vector2.new(sB.X, sB.Y), 1.4, espColor)
								boneIdx += 1
							end
						end
					end
				end
				for i = boneIdx, #v.bones do v.bones[i].Visible = false end
			else
				v.headCircle.Visible = false
				for _, b in ipairs(v.bones) do b.Visible = false end
			end
		else
			hideVisual(v)
		end
	end
end)

-- 에임봇 시점 보정 (카메라 회전 각도 Yaw/Pitch 적용)
RunService:BindToRenderStep("OllieAimbotLock", Enum.RenderPriority.Camera.Value + 5, function()
	local cam = workspace.CurrentCamera
	if not state.aimbot or not cam then return end

	local target = getBestAimTarget()
	if target then
		local camPos = cam.CFrame.Position
		local delta = target.Position - camPos
		if delta.Magnitude > 0.05 then
			local lookCFrame = CFrame.lookAt(camPos, target.Position)
			local currentLook = cam.CFrame.LookVector
			local desiredLook = lookCFrame.LookVector
			local blendedLook = currentLook:Lerp(desiredLook, math.clamp(state.aimSmooth, 0.05, 1)).Unit
			cam.CFrame = CFrame.new(camPos, camPos + blendedLook)
		end
	end
end)

