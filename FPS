-- 팀 체크 판별
local function isEnemyForEsp(plr)
	if not plr or plr == player then return false end
	if state.teamCheck then
		if player.Team and plr.Team and player.Team == plr.Team then
			return false
		end
		if player.TeamColor and plr.TeamColor and player.TeamColor == plr.TeamColor and not player.Neutral and not plr.Neutral then
			return false
		end
	end
	return true
end

local function isEnemyForAim(plr)
	if not plr or plr == player then return false end
	if state.aimTeamCheck then
		if player.Team and plr.Team and player.Team == plr.Team then
			return false
		end
		if player.TeamColor and plr.TeamColor and player.TeamColor == plr.TeamColor and not player.Neutral and not plr.Neutral then
			return false
		end
	end
	return true
end

local function createLine(parent, color, thickness)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BackgroundColor3 = color or Color3.fromRGB(0, 255, 120)
	f.BorderSizePixel = 0
	f.Visible = false
	f.Size = UDim2.new(0, 0, 0, thickness or 1.5)
	f.Parent = parent
	return f
end

local function updateLine(f, p1, p2, thickness, color)
	local t = thickness or 1.5
	local dx = p2.X - p1.X
	local dy = p2.Y - p1.Y
	local dist = math.sqrt(dx * dx + dy * dy)
	if dist < 1 then
		f.Visible = false
		return
	end
	if color then f.BackgroundColor3 = color end
	f.Size = UDim2.new(0, dist, 0, t)
	f.Position = UDim2.new(0, (p1.X + p2.X) * 0.5, 0, (p1.Y + p2.Y) * 0.5)
	f.Rotation = math.deg(math.atan2(dy, dx))
	f.Visible = true
end

